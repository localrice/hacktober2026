# Flask Configuration
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
FLASK_DEBUG=True
SESSION_COOKIE_SECURE=False
WTF_CSRF_ENABLED=True

# Gemma Vision Model Configuration
# Option A: Google AI Studio / Gemini API (Gemma or Gemini vision models)
# e.g., GEMMA_API_KEY=AIzaSy...
GEMMA_API_KEY=
GEMMA_MODEL_NAME=gemma-4-26b
GEMMA_API_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
GEMMA_PROVIDER=auto

# Option B: Local or Remote OpenAI-Compatible Endpoint (e.g. Ollama, vLLM, OpenRouter)
# GEMMA_API_URL=http://localhost:11434/v1/chat/completions
# GEMMA_MODEL_NAME=gemma3:latest
# GEMMA_PROVIDER=openai_compatible

# Fallback behavior when GEMMA_API_KEY is unset or API is unreachable
# Set to true for offline testing / demonstration mode
GEMMA_MOCK_FALLBACK=true

# Upload and limit settings
MAX_CONTENT_LENGTH=16777216
MAX_FOLLOWUP_ROUNDS=3
